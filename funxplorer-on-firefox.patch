+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  padding-block-start: 12vh;
+}
+
+.home h1 {
+  margin: 16px 0 8px;
+  font-size: 2.4rem;
+}
+
+.home p,
+.status,
+.snippet,
+footer {
+  color: var(--muted);
+}
+
+.hidden {
