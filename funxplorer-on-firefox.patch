+    <main>
+      <section id="home" class="home hidden">
+        <img class="home-logo" src="/logo.png" alt="Funxplorer" />
+        <h1>Funsearch</h1>
+        <form id="home-search" class="search-form home-search" action="/" method="get">
+          <label class="visually-hidden" for="q">Search</label>
